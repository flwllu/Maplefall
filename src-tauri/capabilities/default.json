{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "枫落工具默认权限",
  "windows": ["main", "tasks", "task-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:default"
  ]
}
