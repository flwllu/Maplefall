{
  "app": {
    "windows": [
      {
        "title": "枫落工具",
        "width": 980,
        "height": 740,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "windowEffects": { "effects": [], "state": "inactive" }
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "icon": ["icons/icon.png"],
    "resources": [
      "resources/bin/whisper_cpp/linux-x64/*",
      "resources/bin/whisper_cpp/linux-arm64/*",
      "resources/bin/ffmpeg/ffmpeg",
      "resources/bin/ffmpeg/ffprobe",
      "resources/models/*.bin",
      "resources/models/*.onnx",
      "resources/models/README.md",
      "resources/licenses/*"
    ]
  }
}
